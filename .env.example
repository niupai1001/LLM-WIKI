# Compatible chat/completions API endpoint. Blank means no AI processing.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Enable only for providers supporting response_format=json_object.
LLM_JSON_MODE=true
# Original evidence character budget; long documents are explicitly marked excerpts.
LLM_CONTEXT_CHARS=160000
# First develop with human-triggered drafts and manual approval.
AUTO_DRAFT=false
MAX_PER_FEED=12
TZ=Asia/Shanghai
